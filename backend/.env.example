# Copy this file to .env and fill in real values for local development.

# Supabase project (same values the frontend uses)
SUPABASE_URL=https://zhrtrcafpkxnsgjponmg.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Fernet key used to encrypt saved API keys/credentials at rest.
# Leave unset for local dev — a key file (.enc_key) is auto-generated.
# In production, set this explicitly (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ) so encrypted rows survive redeploys.
ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:4173
